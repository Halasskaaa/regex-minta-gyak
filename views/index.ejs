<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
         Profil szerkeztése
    </title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Profil szerkeztése</h1>

    <form method="post">
        <label>Username: <br>
            <input type="text" name="username">
        </label>

        <% if(locals.error) { %>
            <p><%= locals.error %></p>
        <% } %>

        <br>
        <label>Nickname: <br>
            <input type="text" name="nickname">
        </label> <br>

        <% if(locals.error2) { %>
            <p><%= locals.error2 %></p>
        <% } %>

        <br><button type="submit">Módosítás</button>
    </form>


</body>
</html>